{
	id: "verity_chapter"
	order_index: 999
	filename: "verity"
	title: "VERITY"
	subtitle: [
		"A small voice followed you into this world."
		""
		"It seems friendly."
		""
		"It already knows you are here."
	]
	icon: {
		id: "minecraft:chest"
	}
	default_quest_shape: "circle"
	default_hide_dependency_lines: false
	quests: [
		{
			id: "verity_meet_verity"
			x: 0.0d
			y: 0.0d
			shape: "hexagon"
			size: 2.0d
			title: "MEET VERITY!"
			subtitle: "Something arrived with you."
			icon: {
				id: "minecraft:chest"
			}
			description: [
				"Something arrived before you did."
				""
				"A sealed box now rests nearby, even though nothing was there moments ago. It shifts whenever you move, and a muffled voice follows the sound of your footsteps from inside."
				""
				"Whatever is trapped in there already knows you are close."
				""
				"Open the box."
				"{@pagebreak}"
				"The creature calls himself Verity."
				""
				"He claims to be your personal helper and says he knows almost everything. He also seems unusually happy that you were the one who opened the box."
				""
				"For now, he appears harmless."
			]
			tasks: [
				{
					id: "open_verity_box"
					type: "custom"
					title: "Open your sealed box and meet Verity"
				}
			]
			rewards: [
				{
					id: "verity_meet_verity_xp"
					type: "xp"
					xp: 50
				}
			]
		}
		{
			id: "verity_say_hello"
			x: 4.0d
			y: 0.0d
			shape: "circle"
			size: 1.5d
			title: "SAY HELLO"
			subtitle: "He is waiting for your voice."
			dependencies: ["verity_meet_verity"]
			icon: {
				id: "minecraft:echo_shard"
			}
			description: [
				"Verity has not looked away since leaving the box."
				""
				"He introduced himself without asking who you were, and he speaks as though the two of you were always supposed to meet. Now he waits in silence, watching for something only you can provide."
				""
				"Stand close, hold your push-to-talk key, and greet him."
				"{@pagebreak}"
				"Verity can hear you clearly."
				""
				"He understood your greeting, recognized that you were speaking to him, and responded as though he had been waiting for your voice specifically."
				""
				"More strangely, he claims he already knew what you sounded like."
			]
			tasks: [
				{
					id: "say_hello_to_verity"
					type: "custom"
					title: "Say hello to Verity (voice intent)"
				}
			]
			rewards: [
				{
					id: "verity_say_hello_xp"
					type: "xp"
					xp: 35
				}
			]
		}
		{
			id: "verity_make_a_sound"
			x: 8.0d
			y: 1.0d
			shape: "circle"
			size: 1.5d
			title: "MAKE A SOUND"
			subtitle: "A demonstration of incredible power."
			dependencies: ["verity_say_hello"]
			icon: {
				id: "minecraft:note_block"
			}
			description: [
				"Verity claims he can do almost anything."
				""
				"So far, most of his talents have involved talking about how capable he is. Perhaps it is time for a more practical demonstration."
				""
				"Stand close, hold your push-to-talk key, and ask Verity to make a sound."
				"{@pagebreak}"
				"Verity has successfully demonstrated one of his many talents."
				""
				"The result was technically a sound. He is extremely proud of it and now appears to consider sound-making a repeatable scientific experiment."
			]
			tasks: [
				{
					id: "make_sound_with_verity"
					type: "custom"
					title: "Ask Verity to make a sound."
				}
			]
			rewards: [
				{
					id: "verity_make_a_sound_xp"
					type: "xp"
					xp: 40
				}
			]
		}
	]
}
